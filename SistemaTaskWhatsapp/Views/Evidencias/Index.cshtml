@model IEnumerable<SistemaTaskWhatsapp.Models.Evidencia>

@{
    ViewData["Title"] = "Lista de evidencias";
}

<div class="contenedor-principal">
    <div class="d-flex justify-content-between align-items-center">
        <h3>@ViewData["Title"]</h3>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nueva evidencia
        </a>
    </div>
    <div class="mt-4 table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Descripción</th>
                    <th>Reporte</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            <i class="bi bi-image"></i>
                            No hay evidencias registradas...
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var evidencia in Model)
                    {
                        <tr>
                            <td>@evidencia.Id</td>
                            <td>@evidencia.Descripcion</td>
                            <td>@evidencia.Reporte?.Nombre</td>
                            <td class="text-center">
                                <button title="Ver evidencia"
                                    class="btn btn-sm btn-primary btnPreviewEvidencia" data-url="@evidencia.Url"
                                    data-bs-toggle="modal" data-bs-target="#modalPreviewEvidencia">
                                    <i class="bi bi-eye"></i>
                                </button>

                                <a title="Editar"
                                    class="btn btn-sm btn-warning" asp-action="Edit"
                                    asp-route-id="@evidencia.Id"><i class="bi bi-pencil"></i>
                                </a>
                                
                                <button title="Eliminar"
                                    class="btn btn-sm btn-danger" data-id="@evidencia.Id"
                                    data-bs-toggle="modal" data-bs-target="#modalEliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-danger">
                <h4 class="modal-title text-white">Eliminar evidencia</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <h5>¿Deseas eliminar esta evidencia?</h5>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <form asp-action="Delete" method="post">
                    <input id="inputId" name="id" type="hidden" />
                    <button type="submit" class="btn btn-danger">
                        Eliminar
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

<!-- Modal Preview Evidencia -->
<div class="modal fade" id="modalPreviewEvidencia" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Vista previa del archivo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <div id="previewContainer"
                     class="d-flex justify-content-center align-items-center"
                     style="min-height: 400px;">
                    <p class="text-muted">Cargando vista previa...</p>
                </div>
            </div>

            <div class="modal-footer">
                <a id="btnDescargarArchivo"
                   class="btn btn-success"
                   target="_blank"
                   download>
                    <i class="bi bi-download"></i> Descargar
                </a>
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/evidencia/evidenciaIndex.js"></script>
}
