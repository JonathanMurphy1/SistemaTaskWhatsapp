@model SistemaTaskWhatsapp.Models.Supervisor
@using SistemaTaskWhatsapp.Utilidades

@{
    ViewData["Title"] = "Editar Supervisor";
}

<div class="contenedor-principal">
    <div class="text-center">
        <h3 class="col-3">@ViewData["Title"]</h3>
    </div>
    <div class="col-5 mt-4 border rounded shadow p-3">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label for="nombre">Nombre:</label>
                <input type="text" id="nombre" asp-for="Nombre" class="form-control" placeholder="Escriba el nombre del supervisor" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="col-5">
                <div class="form-group">
                    <label asp-for="Estado">Estado:</label>
                    <select asp-for="Estado"
                            class="form-control"
                            asp-items="Html.GetEnumSelectList<EstadosSupervisor>()">
                        <option value="">-- Seleccione un Estado --</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex justify-content-center gap-2 mt-3">
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
                <button type="submit" class="btn btn-success">Registrar</button>
            </div>
        </form>
    </div>
</div>