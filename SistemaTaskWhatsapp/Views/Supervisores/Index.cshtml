@model IEnumerable<SistemaTaskWhatsapp.Models.Supervisor>
@using SistemaTaskWhatsapp.Utilidades

@{
    ViewData["Title"] = "Lista de supervisores";
}

<div class="contenedor-principal">
    <div class="d-flex justify-content-between align-items-center">
        <h3>@ViewData["Title"]</h3>
    </div>
    <div class="mt-4 table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            <i class="bi bi-person-badge"></i>
                            No hay supervisores registrados...
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var supervisor in Model)
                    {
                        <tr>
                            <td>@supervisor.Id</td>
                            <td><strong>@supervisor.Nombre</strong></td>
                            <td>
                                @if (supervisor.Estado == EstadosSupervisor.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-warning btnCambiarEstado"
                                        title="Cambiar estado" data-id="@supervisor.Id"
                                        data-nombre="@supervisor.Nombre" data-estado="@supervisor.Estado"
                                        data-bs-toggle="modal" data-bs-target="#modalEstado">
                                        Cambiar estado
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-danger">
                <h4 class="modal-title text-white">Eliminar</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <h5>¿Estás seguro de querer eliminar este supervisor?</h5>
                <p id="mostrarNombre"></p>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cerrar
                    </button>
                    <form asp-action="Delete" method="post">
                        <input id="inputId" name="id" type="hidden" />
                        <button type="submit" class="btn btn-danger">
                            Borrar
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Modal Cambiar Estado -->
<div class="modal fade" id="modalEstado" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white">Cambiar estado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <p>
                    <strong>Supervisor:</strong>
                    <span id="nombreSupervisor"></span>
                </p>

                <form asp-action="CambiarEstado" method="post">
                    <input type="hidden" id="estadoSupervisorId" name="id" />

                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <select id="estadoSelect" name="estado" class="form-select">
                            <option value="Inactivo">Inactivo</option>
                            <option value="Activo">Activo</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-warning">
                            Guardar
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/supervisor/supervisorIndex.js"></script>
}
