@{
    ViewData["Title"] = "Lista de Supervisores";
}
<h1>@ViewData["Title"]</h1>


<div class="row">
    <div class="col-4 text-start">
        <p>Lista de supervisores</p>
    </div>
    <div class="col-4 text-end">
        <a asp-action="Create" class="btn btn-primary">
            Agregar <i class="fa-solid fa-plus"></i>
        </a>
    </div>
</div>

<div class="container mt-4">
    <!--Token para validacion de endpoints-->
    @Html.AntiForgeryToken()

    <div class="table-responsive">
        <table id="tblUsuario" class="table table-striped table-hover table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <!--Aqui se llena con DataTables-->
        </table>
    </div>
</div>


<!--Modal eliminar-->
<div class="modal fade" id="modalEliminar">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger">
                <h4 class="modal-title text-white">Eliminar</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h5>Estas seguro de querer borrar este usuario?</h5>
                <p id="mostrarId"></p>
                <p id="mostrarNombre"></p>
                <br />
                <div class="d-flex justify-content-around align-content-center gap-2">
                    <form method="post" asp-action="Delete">
                        <input id="idInput" type="hidden" name="id" value="" />
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fa-solid fa-xmark"></i> Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash"></i> Eliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Usuario/UsuarioIndex.js"></script>
}

