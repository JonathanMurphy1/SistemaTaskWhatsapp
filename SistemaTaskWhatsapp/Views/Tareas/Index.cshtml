@model IEnumerable<SistemaTaskWhatsapp.Models.Tarea>
@using SistemaTaskWhatsapp.Utilidades

@{
    ViewData["Title"] = "Lista de tareas";
}

<div class="contenedor-principal">
    <div class="d-flex justify-content-between align-items-center">
        <h3>@ViewData["Title"]</h3>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nueva tarea
        </a>
    </div>
    <div class="mt-4 table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Proyecto</th>
                    <th>Descripción</th>
                    <th>Inicio</th>
                    <th>Fecha de entrega</th>
                    <th>Fecha de finalización</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            <i class="bi bi-list-task"></i>
                            No hay tareas registradas...
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var tarea in Model)
                    {
                        <tr>
                            <td>@tarea.Id</td>
                            <td><strong>@tarea.Nombre</strong></td>
                            <td>@(tarea.ProyectoId != null? tarea.Proyecto?.Nombre : "Sin asignar")</td>
                            <td>@tarea.Descripcion</td>
                            <td>@tarea.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td>@(tarea.FechaEntrega?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>@(tarea.FechaTermino == null ? "Vigente" : tarea.FechaTermino?.ToString("dd/MM/yyyy"))</td>
                            <td>
                                @if (tarea.Estado == EstadosTarea.Finalizada)
                                {
                                    <span class="badge bg-success">Finalizada</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@tarea.Estado</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (tarea.Estado != EstadosTarea.Finalizada)
                                {
                                    <button title="Finalizar"
                                        class="btn btn-sm btn-success" data-id="@tarea.Id"
                                        data-nombre="@tarea.Nombre" data-bs-toggle="modal"
                                        data-bs-target="#modalFinalizar"><i class="bi bi-check-lg"></i>
                                    </button>
                                    
                                    <a title="Editar"
                                        class="btn btn-sm btn-warning" asp-action="Edit"
                                        asp-route-id="@tarea.Id"><i class="bi bi-pencil"></i>
                                    </a>
                                }
                                <button title="Eliminar"
                                    class="btn btn-sm btn-danger" data-id="@tarea.Id"
                                    data-nombre="@tarea.Nombre" data-bs-toggle="modal"
                                    data-bs-target="#modalEliminar"><i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-danger">
                <h4 class="modal-title text-white">Eliminar tarea</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <h5>¿Deseas eliminar esta tarea?</h5>
                <p class="mostrarNombre"></p>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <form asp-action="Delete" method="post">
                    <input class="inputId" name="id" type="hidden" />
                    <button type="submit" class="btn btn-danger">
                        Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Finalizar -->
<div class="modal fade" id="modalFinalizar">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-success">
                <h4 class="modal-title text-white">Finalizar tarea</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <h5>¿Deseas finalizar esta tarea?</h5>
                <p class="mostrarNombre"></p>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <form asp-action="Finalizar" method="post">
                    <input class="inputId" name="id" type="hidden" />
                    <button type="submit" class="btn btn-success">
                        Finalizar
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tarea/tareaIndex.js"></script>
}
