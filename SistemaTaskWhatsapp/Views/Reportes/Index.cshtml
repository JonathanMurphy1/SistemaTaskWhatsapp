@model IEnumerable<SistemaTaskWhatsapp.Models.Reporte>
@using SistemaTaskWhatsapp.Utilidades

@{
    ViewData["Title"] = "Lista de reportes";
}

<div class="contenedor-principal">
    <div class="d-flex justify-content-between">
        <h3 class="col-3">@ViewData["Title"]</h3>
        <a asp-action="Create" class="btn btn-success col-2">Nuevo reporte</a>
    </div>
    <div class="mt-4">
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Tarea</th>
                    <th>Contenido</th>
                    <th>Inconvenientes</th>
                    <th>Comentarios</th>
                    <th>Fecha de subida</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">No hay reportes registrados...</td>
                    </tr>
                }
                else
                {
                    foreach (var reporte in Model)
                    {
                        <tr>
                            <td>@reporte.Id</td>
                            <td>@reporte.Nombre</td>
                            <td>@reporte.Tarea?.Nombre</td>
                            <td>@reporte.Contenido</td>
                            <td>@(String.IsNullOrWhiteSpace(reporte.Inconvenientes) ? "Sin inconvenientes" : reporte.Inconvenientes)</td>
                            <td>@(String.IsNullOrWhiteSpace(reporte.ComentarioEmpleado) ? "Sin comentarios" : reporte.ComentarioEmpleado)</td>
                            <td>@(reporte.FechaSubida.ToString("dd/MM/yyyy"))</td>
                            <td>@reporte.Estado</td>
                            <td class="col-2">
                                <a class="btn btn-warning" asp-action="Edit" asp-route-id="@reporte.Id">Editar</a>
                                <button class="btn btn-danger" data-id="@reporte.Id" data-nombre="@reporte.Tarea?.Nombre" data-bs-toggle="modal" data-bs-target="#modalEliminar">Borrar</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-danger">
                <h4 class="modal-title text-white">Eliminar</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <h5>Estas seguro de querer eliminar este reporte? </h5>
                <strong>Id: </strong> <p class="mostrarId"></p>
                <strong>Tarea: </strong> <p class="mostrarNombre"></p>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <form asp-action="Delete" method="post">
                        <input class="inputId" name="id" value="" type="hidden" />
                        <button type="submit" class="btn btn-danger">Borrar</button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reporte/reporteIndex.js"></script>
}
