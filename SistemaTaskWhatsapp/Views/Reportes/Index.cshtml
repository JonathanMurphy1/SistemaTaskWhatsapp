@model IEnumerable<SistemaTaskWhatsapp.Models.Reporte>
@using SistemaTaskWhatsapp.Utilidades

@{
    ViewData["Title"] = "Lista de reportes";
}

<div class="contenedor-principal">
    <div class="d-flex justify-content-between align-items-center">
        <h3>@ViewData["Title"]</h3>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo reporte
        </a>
    </div>
    <div class="mt-4 table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Tarea</th>
                    <th>Colaborador</th>
                    <th>Contenido</th>
                    <th>Inconvenientes</th>
                    <th>Comentarios</th>
                    <th>Fecha de subida</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">
                            <i class="bi bi-clipboard-data"></i>
                            No hay reportes registrados...
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var reporte in Model)
                    {
                        <tr>
                            <td>@reporte.Id</td>
                            <td><strong>@reporte.Nombre</strong></td>
                            <td>@reporte.Tarea?.Nombre</td>
                            <td>
                                <div>
                                    <strong>@reporte.Empleado.Usuario.Nombre</strong><br />
                                    <small class="text-muted">@reporte.Empleado.Usuario.Email</small>
                                </div>
                            </td>
                            <td>
                                <span class="contenido-preview d-inline-block"
                                    data-bs-toggle="tooltip" title="@reporte.Contenido">
                                    @reporte.Contenido
                                </span>
                            </td>
                            <td> @(string.IsNullOrWhiteSpace(reporte.Inconvenientes) ? "Sin inconvenientes" : reporte.Inconvenientes)</td>
                            <td>@(string.IsNullOrWhiteSpace(reporte.ComentarioEmpleado)  ? "Sin comentarios" : reporte.ComentarioEmpleado)</td>
                            <td>@reporte.FechaSubida.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (reporte.Estado == EstadosReporte.Aceptado)
                                {
                                    <span class="badge bg-success">Aceptado</span>
                                }
                                else if (reporte.Estado == EstadosReporte.Rechazado)
                                {
                                    <span class="badge bg-danger">Rechazado</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pendiente de revisar</span>
                                }
                            </td>
                            <td class="text-center">
                                <a title="Editar"
                                    class="btn btn-sm btn-warning" asp-action="Edit"
                                    asp-route-id="@reporte.Id"> <i class="bi bi-pencil"></i>
                                </a>
                                
                                <button title="Eliminar"
                                    class="btn btn-sm btn-danger" data-id="@reporte.Id"
                                    data-nombre="@reporte.Tarea?.Nombre" data-bs-toggle="modal"
                                    data-bs-target="#modalEliminar"><i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-danger">
                <h4 class="modal-title text-white">Eliminar</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <h5>Estas seguro de querer eliminar este reporte? </h5>
                <strong>Id: </strong> <p class="mostrarId"></p>
                <strong>Tarea: </strong> <p class="mostrarNombre"></p>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <form asp-action="Delete" method="post">
                        <input class="inputId" name="id" value="" type="hidden" />
                        <button type="submit" class="btn btn-danger">Borrar</button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/reporte/reporteIndex.js"></script>


    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tooltipTriggerList = [].slice.call(
                document.querySelectorAll('[data-bs-toggle="tooltip"]')
            );

            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}
