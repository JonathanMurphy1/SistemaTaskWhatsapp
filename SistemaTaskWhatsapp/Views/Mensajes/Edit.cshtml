@model SistemaTaskWhatsapp.Models.ViewModels.MensajeVM

@{
    ViewData["Title"] = "Registrar Mensaje";
}

<div class="contenedor-principal">
    <div class="text-center">
        <h3 class="col-3">@ViewData["Title"]</h3>
    </div>
    <div class="col-5 mt-4 border rounded shadow p-3 fade-in-page">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="Mensaje.Id" />
            <input type="hidden" asp-for="Mensaje.Activo" />
            <input type="hidden" asp-for="Mensaje.FechaCreacion" />

            <!-- EMPRESA -->
            <div class="form-group">
                <label>Empresa:</label>
                <select asp-for="Mensaje.EmpresaId"
                        asp-items="@Model.ListaEmpresas"
                        class="form-select">
                    <option disabled selected value="">--Elija una empresa--</option>
                </select>
                <span asp-validation-for="Mensaje.EmpresaId" class="text-danger"></span>
            </div>

            <br />

            <!-- TIPO -->
            <div class="form-group">
                <label>Mensaje para:</label>
                <select asp-for="Mensaje.Tipo" class="form-control">
                    <option disabled selected value="">-- Seleccione el tipo de usuario --</option>
                    <option value="1">Supervisor</option>
                    <option value="2">Empleado</option>
                </select>
                <span asp-validation-for="Mensaje.Tipo" class="text-danger"></span>

            </div>

            <br />

            <!-- CONTENIDO -->
            <div class="form-group">
                <label>Contenido:</label>
                <textarea asp-for="Mensaje.Contenido"
                          class="form-control"
                          placeholder="Escriba el mensaje..."></textarea>
                <span asp-validation-for="Mensaje.Contenido" class="text-danger"></span>
            </div>

            <br />

            <!-- HORA -->
            <div class="form-group">
                <label>Hora de envío:</label>
                <input type="time" id="hora" class="form-control" />
            </div>

            <br />

            <!-- FRECUENCIA -->
            <div class="form-group">
                <label>Frecuencia:</label>
                <select id="frecuencia" class="form-control">
                    <option value="diario">Diario</option>
                    <option value="laboral">Lunes a Viernes</option>
                    <option value="semanal">Semanal (Cada lunes)</option>
                </select>
            </div>

            <!-- CRON OCULTO -->
            <input type="hidden" asp-for="Mensaje.Cron" id="cron" />

            <br />

            <div class="d-flex justify-content-center gap-2 mt-3">
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
                <button type="submit" class="btn btn-success">Editar</button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <script>
        function generarCron() {
            const hora = document.getElementById("hora").value;
            const frecuencia = document.getElementById("frecuencia").value;

            if (!hora) return;

            const [h, m] = hora.split(":");

            let cron = "";

            switch (frecuencia) {
                case "diario":
                    cron = `${m} ${h} * * *`;
                    break;

                case "laboral":
                    cron = `${m} ${h} * * 1-5`;
                    break;

                case "semanal":
                    cron = `${m} ${h} * * 1`;
                    break;
            }

            document.getElementById("cron").value = cron;

            console.log("CRON generado:", cron); //DEBUG
        }

        //Se ejecuta al cambiar valores
        document.getElementById("hora").addEventListener("change", generarCron);
        document.getElementById("frecuencia").addEventListener("change", generarCron);

        //Seguridad extra al enviar
        document.querySelector("form").addEventListener("submit", function (event) {

            generarCron(); // asegura que se genere

            const cron = document.getElementById("cron").value;

            if (!cron) {
                alert("No se pudo generar el cron");
                event.preventDefault();
            }
        });
    </script>

    <script>
        //Cargar datos del cron a la hora de editarlo
        function cargarDesdeCron() {
            const cron = document.getElementById("cron").value;

            if (!cron) return;

            const partes = cron.split(" ");

            if (partes.length < 5) return;

            const minuto = partes[0];
            const hora = partes[1];
            const dias = partes[4];

            //hora
            document.getElementById("hora").value =
                `${hora.padStart(2, '0')}:${minuto.padStart(2, '0')}`;

            //frecuencia
            let frecuencia = "diario";

            if (dias === "1-5") frecuencia = "laboral";
            else if (dias === "1") frecuencia = "semanal";

            document.getElementById("frecuencia").value = frecuencia;
        }

        // Ejecutar al cargar página
        document.addEventListener("DOMContentLoaded", function () {
            cargarDesdeCron();
        });
    </script>
}