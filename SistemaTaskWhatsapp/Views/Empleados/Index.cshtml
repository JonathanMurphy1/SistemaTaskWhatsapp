@model IEnumerable<SistemaTaskWhatsapp.Models.Empleado>

@{
    ViewData["Title"] = "Lista de empleados";
}

<div class="contenedor-principal">
    <div class="d-flex justify-content-between">
        <h3 class="col-3">@ViewData["Title"]</h3>
    </div>
    <div class="mt-4">
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Fecha de registro</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if(Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted" >No hay empleados registrados...</td>
                    </tr>
                }
                else
                {
                    foreach(var empleado in Model)
                    {
                        <tr>
                            <td>@empleado.Id</td>
                            <td>@empleado.Nombre</td>
                            <td>@empleado.FechaRegistro</td>
                            <td>@empleado.Estado</td>
                            <td>
                                <button class="btn btn-warning btnCambiarEstado"
                                        data-id="@empleado.Id"
                                        data-nombre="@empleado.Nombre"
                                        data-estado="@empleado.Estado"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEstado">
                                    Cambiar estado
                                </button>
                                <button class="btn btn-danger" data-id="@empleado.Id" data-nombre="@empleado.Nombre" data-bs-toggle="modal" data-bs-target="#modalEliminar">Borrar</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-danger">
                <h4 class="modal-title text-white">Eliminar</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <h5>Estas seguro de querer eliminar este empleado? </h5>
                <p id="mostrarNombre"></p>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <form asp-action="Delete" method="post">
                        <input id="inputId" name="id" value="" type="hidden"/>
                        <button type="submit" class="btn btn-danger">Borrar</button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalEstado" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white">Cambiar estado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <p><strong>Empleado:</strong> <span id="nombreEmpleado"></span></p>

                <form asp-action="CambiarEstado" method="post">
                    <input type="hidden" id="estadoEmpleadoId" name="id" />
                    <div class="form-group">
                        <label>Estado</label>
                        <select id="estadoSelect" name="estado" class="form-select">
                            <option value="Inactivo">Inactivo</option>
                            <option value="Activo">Activo</option>
                        </select>
                    </div>

                    <div class="mt-3 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-warning">
                            Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/empleado/empleadoIndex.js"></script>
}