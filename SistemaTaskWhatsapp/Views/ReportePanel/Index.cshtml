@model IEnumerable<SistemaTaskWhatsapp.Models.Reporte>

@using SistemaTaskWhatsapp.Utilidades;

@{
    ViewData["Title"] = "Panel de reportes";
    int proyectoId = ViewBag.ProyectoId;
    int tareaId = ViewBag.TareaId;
}

<div class="text-center">
    <h1 class="display-4">Panel de reportes</h1>
    <div class="container border rounded shadow">
        <h2>Reportes</h2>
        <br />
        <div class="contenedor-cartas p-4 row gap-4">
            @if (!Model.Any())
            {
                <h3 class="text-center text-muted">No hay reportes...</h3>
                <a class="btn btn-secondary" asp-controller="TareaPanel" asp-action="Index" asp-route-id="@proyectoId"><i class="bi bi-arrow-left"></i> Volver</a>
            }
            else
            {
                <div class="d-flex justify-content-between">
                    <h4>Tarea: @Model.First().Tarea.Nombre</h4>
                    <a class="btn btn-secondary" asp-controller="TareaPanel" asp-action="Index" asp-route-id="@proyectoId"><i class="bi bi-arrow-left"></i> Volver</a>
                </div>
                foreach (var vm in Model)
                {
                    <div class="col-4 card shadow">
                        <div class="card-header">
                            <div class="d-flex justify-content-between">
                                <h3 class="card-title">Id: #@vm.Id</h3>
                            </div>
                        </div>
                        <div class="card-body text-start">
                            <strong>Estado:</strong> <span class="badge bg-info">@Html.DisplayFor(m => vm.Estado)</span>
                            <br />
                            <strong>Contenido:</strong>
                            <p>@vm.Contenido</p>
                            <strong>Inconvenientes:</strong>
                            <p>@vm.Inconvenientes</p>
                            <strong>Comentarios:</strong>
                            <p>@vm.ComentarioEmpleado</p>
                            <p><strong>Fecha de subida:</strong> @vm.FechaSubida.ToString("dd/MM/yyyy")</p>
                        </div>
                        <div class="card-footer">
                            <div class="d-flex justify-content-center">
                                @if(vm.Estado == EstadosReporte.PendienteRevisar)
                                {
                                    <button class="btn btn-primary" data-reporteId="@vm.Id" data-bs-toggle="modal" data-bs-target="#modalRevisar"><i class="bi bi-clipboard-check"></i> Revisar</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!--Modal Revisar-->
<div class="modal fade" id="modalRevisar">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h4 class="modal-title text-white">Retroalimentación</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formRevisar" method="post" asp-action="Revisar">
                <div class="modal-body">
                    <input type="hidden" name="TareaId" value="@tareaId"/>
                    <input class="reporte-id" type="hidden" name="ReporteId" value="" />
                    <div class="form-group">
                        <label for="inputComentario" class="fw-bold">Comentarios:</label>
                        <textarea style="height:300px;" id="inputComentario" class="form-control comentario-input" name="Comentario" 
                            placeholder="Escriba algun comentario sobre el reporte o actividad realizada..."></textarea>
                    </div>
                    <div class="form-group mt-3">
                        <label class="fw-bold">Estado:</label>
                        <label for="aceptado" class="form-check-label">Aceptado:</label>
                        <input name="EstadoReporte" id="aceptado" type="radio" class="form-check-input" value="1"/>
                        <label for="rechazado" class="form-check-label">Rechazado:</label>
                        <input name="EstadoReporte" id="rechazado" type="radio" class="form-check-input" value="2" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-success">Mandar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/reporte-panel/repote-panel-index.js"></script>
}
