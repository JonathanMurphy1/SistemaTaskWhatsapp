@model IEnumerable<SistemaTaskWhatsapp.Models.Reporte>

@using SistemaTaskWhatsapp.Utilidades;

@{
    ViewData["Title"] = "Panel de reportes";
    int proyectoId = ViewBag.ProyectoId;
    int tareaId = ViewBag.TareaId;
}

<div class="text-center">
    <h1 class="display-4">Panel de reportes</h1>
    <div class="container p-4 border rounded shadow">
        <h2>Reportes</h2>
        <br />
            @if (!Model.Any())
            {
                <h3 class="text-center text-muted">No hay reportes...</h3>
                <a class="btn btn-secondary" asp-controller="TareaPanel" asp-action="Index" asp-route-id="@proyectoId"><i class="bi bi-arrow-left"></i> Volver</a>
            }
            else
            {
                <div class="d-flex justify-content-between">
                    <h4>Tarea: @Model.First().Tarea.Nombre</h4>
                    <a class="btn btn-secondary" asp-controller="TareaPanel" asp-action="Index" asp-route-id="@proyectoId"><i class="bi bi-arrow-left"></i> Volver</a>
                </div>
                <br />
                <div class="contenedor-cartas row row-cols-1 row-cols-md-3 gx-3 gy-3">
                    @foreach (var vm in Model)
                    {
                        <div class="col">
                            <div class="card shadow">
                                <div class="card-header">
                                    <div class="d-flex justify-content-between">
                                        <h3 class="card-title">Id: #@vm.Id</h3>
                                    </div>
                                </div>
                                <div class="card-body text-start">
                                    @{
                                        string estadoColor;
                                        switch (vm.Estado)
                                        {
                                            case EstadosReporte.PendienteRevisar:
                                                estadoColor = "warning";
                                                break;
                                            case EstadosReporte.Aceptado:
                                                estadoColor = "success";
                                                break;
                                            case EstadosReporte.Rechazado:
                                                estadoColor = "danger";
                                                break;
                                            default:
                                                estadoColor = "dark";
                                                break;
                                        }
                                    }
                                    <strong>Colaborador:</strong> <span>@vm.Empleado.Usuario.Nombre</span>
                                    <br />
                                    <strong>Estado:</strong> <span class="badge bg-@estadoColor">@Html.DisplayFor(m => vm.Estado)</span>
                                    <br />
                                    <strong>Contenido:</strong>
                                    <p>@vm.Contenido</p>
                                    <strong>Inconvenientes:</strong>
                                    <p>@(vm.Inconvenientes ?? "Sin inconvenientes")</p>
                                    <strong>Comentarios:</strong>
                                    <p>@(vm.ComentarioEmpleado ?? "Sin Comentarios")</p>
                                    <p><strong>Fecha de subida:</strong> @vm.FechaSubida.ToString("dd/MM/yyyy")</p>
                                </div>
                                <div class="card-footer">
                                    <div class="d-flex justify-content-center gap-2">
                                        @if (vm.Evidencias != null && vm.Evidencias.Any())
                                        {
                                            var evidencia = vm.Evidencias.First();

                                            <button class="btn btn-info btnPreviewEvidencia"
                                                    style="color:white;"
                                                    data-url="@evidencia.Url"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalPreviewEvidencia">
                                                <i class="bi bi-file-earmark-text"></i>
                                                Evidencia
                                            </button>
                                        }
                                        @if (vm.Estado == EstadosReporte.PendienteRevisar)
                                        {
                                            <button class="btn btn-primary" data-reporteId="@vm.Id" data-bs-toggle="modal" data-bs-target="#modalRevisar"><i class="bi bi-clipboard-check"></i> Revisar</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-warning" data-reporteId="@vm.Id" data-bs-toggle="modal" data-bs-target="#modalDetalle"><i class="bi bi-eye-fill"></i> Ver retroalimentación</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

            }
    </div>
</div>


<!-- Modal Preview Evidencia -->
<div class="modal fade" id="modalPreviewEvidencia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Vista previa de la evidencia</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div id="previewContainer" class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
                    <p class="text-muted">Cargando vista previa...</p>
                </div>
            </div>
            <div class="modal-footer">
                <a id="btnDescargarArchivo" class="btn btn-success" target="_blank" download>
                    <i class="fa-solid fa-download"></i> Descargar
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!--Modal Revisar-->
<div class="modal fade" id="modalRevisar">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h4 class="modal-title text-white">Retroalimentación</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formRevisar" method="post" asp-action="Revisar">
                <div class="modal-body">
                    <input type="hidden" name="TareaId" value="@tareaId"/>
                    <input class="reporte-id" type="hidden" name="ReporteId" value="" />
                    <div class="form-group">
                        <label for="inputComentario" class="fw-bold">Comentarios:</label>
                        <textarea style="height:300px;" id="inputComentario" class="form-control comentario-input" name="Comentario" 
                            placeholder="Escriba algun comentario sobre el reporte o actividad realizada..."></textarea>
                    </div>
                    <div class="form-group mt-3">
                        <label class="fw-bold">Estado:</label>
                        <label for="aceptado" class="form-check-label">Aceptado:</label>
                        <input name="EstadoReporte" id="aceptado" type="radio" class="form-check-input" value="1"/>
                        <label for="rechazado" class="form-check-label">Rechazado:</label>
                        <input name="EstadoReporte" id="rechazado" type="radio" class="form-check-input" value="2" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-success">Mandar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!--Modal Detalle-->
<div class="modal fade" id="modalDetalle">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-info">
                <h4 class="modal-title text-white">Retroalimentación</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formEditarRevision" method="post" asp-action="EditarRevision">
                <div class="modal-body">
                    <input type="hidden" name="TareaId" value="@tareaId" />
                    <input class="reporte-id" type="hidden" name="ReporteId" value="" />
                    <input class="revision-id" type="hidden" name="RevisionId" value="" />
                    <strong>Revisado por: </strong><span class="nombre-supervisor"></span>
                    <br />
                    <strong>Fecha: </strong><span class="mostrar-fecha"></span>
                    <div class="form-group">
                        <label for="inputComentario" class="fw-bold">Comentarios:</label>
                        <textarea style="height:300px;" id="inputComentario" class="form-control comentario-input" name="Comentario"
                                  placeholder="Escriba algun comentario sobre el reporte o actividad realizada..."></textarea>
                    </div>
                    <div class="form-group mt-3">
                        <label class="fw-bold">Estado:</label>
                        <label for="aceptado" class="form-check-label">Aceptado:</label>
                        <input name="EstadoReporte" id="aceptado" type="radio" class="form-check-input" value="1" />
                        <label for="rechazado" class="form-check-label">Rechazado:</label>
                        <input name="EstadoReporte" id="rechazado" type="radio" class="form-check-input" value="2" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-success">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/reporte-panel/reporte-panel-index.js"></script>
}
