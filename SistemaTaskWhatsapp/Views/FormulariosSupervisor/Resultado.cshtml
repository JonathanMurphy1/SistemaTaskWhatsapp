@model SistemaTaskWhatsapp.Models.ViewModels.ResultadoFormSupervisorVM

@{
    ViewData["Title"] = "Resultado";
}

<div class="col-12">
    <div class="card border rounded shadow">
        <div class="card-header bg-@(Model.Resultado ? "success" : "danger")">
            <h2 class="card-title text-white fw-bold text-center">
                @(Model.Resultado ? "Correcto" : "Error")
            </h2>
        </div>
        <div class="card-body">
            <h4 class="text-center">@Model.Mensaje</h4>
            <div class="text-center">
                @if (Model.Resultado)
                {
                    <i class="bi bi-check-circle text-success display-1 fw-bold"></i>
                }
                else
                {
                    <i class="bi bi-x-circle text-danger fw-bold display-1"></i>
                }
            </div>
            <p class="text-center">Puede cerrar esta ventana</p>
        </div>
    </div>
</div>
