@model IEnumerable<SistemaTaskWhatsapp.Models.Proyecto>
@using SistemaTaskWhatsapp.Utilidades

@{
    ViewData["Title"] = "Lista de proyectos";
}

<div class="contenedor-principal">
    <div class="d-flex justify-content-between align-items-center">
        <h3>@ViewData["Title"]</h3>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo proyecto
        </a>
    </div>
    <div class="mt-4 table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Programa</th>
                    <th>Empresa</th>
                    <th>Descripción</th>
                    <th>Fecha de registro</th>
                    <th>Fecha de finalización</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="bi bi-kanban"></i>
                            No hay proyectos registrados...
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var proyecto in Model)
                    {
                        <tr>
                            <td>@proyecto.Id</td>
                            <td><strong>@proyecto.Nombre</strong></td>
                            <td>@(proyecto.Empresa?.Programa?.Nombre ?? "Sin programa")</td>
                            <td>@(proyecto.Empresa?.Nombre ?? "Sin asignar")</td>
                            <td>@proyecto.Descripcion</td>
                            <td>@proyecto.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td>@(proyecto.FechaFin == null ? "Vigente" : proyecto.FechaFin?.ToString("dd/MM/yyyy"))</td>
                            <td>
                                @if (proyecto.Estado == EstadosProyecto.Terminado)
                                {
                                    <span class="badge bg-success">Terminado</span>
                                }
                                else if (proyecto.Estado == EstadosProyecto.Activo)
                                {
                                    <span class="badge bg-warning">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@proyecto.Estado</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (proyecto.Estado != EstadosProyecto.Terminado)
                                {
                                    <button title="Finalizar"
                                        class="btn btn-sm btn-success" data-id="@proyecto.Id"
                                        data-nombre="@proyecto.Nombre" data-bs-toggle="modal"
                                        data-bs-target="#modalFinalizar"><i class="bi bi-check-lg"></i>
                                    </button>
                                
                                    <a title="Editar"
                                        class="btn btn-sm btn-warning" asp-action="Edit"
                                        asp-route-id="@proyecto.Id"><i class="bi bi-pencil"></i>
                                    </a>
                                }
                                <button title="Eliminar"
                                    class="btn btn-sm btn-danger" data-id="@proyecto.Id"
                                    data-nombre="@proyecto.Nombre" data-bs-toggle="modal"
                                    data-bs-target="#modalEliminar"><i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Eliminar -->
<div class="modal fade" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-danger">
                <h4 class="modal-title text-white">Eliminar proyecto</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <h5>¿Estás seguro de eliminar este proyecto?</h5>
                <p class="mostrarNombre"></p>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <form asp-action="Delete" method="post">
                    <input class="inputId" name="id" type="hidden" />
                    <button type="submit" class="btn btn-danger">
                        Eliminar
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

<!-- Modal Finalizar -->
<div class="modal fade" id="modalFinalizar">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-success">
                <h4 class="modal-title text-white">Finalizar proyecto</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <h5>¿Deseas finalizar este proyecto?</h5>
                <p class="mostrarNombre"></p>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <form asp-action="Finalizar" method="post">
                    <input class="inputId" name="id" type="hidden" />
                    <button type="submit" class="btn btn-success">
                        Finalizar
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/proyecto/proyectoIndex.js"></script>
}
