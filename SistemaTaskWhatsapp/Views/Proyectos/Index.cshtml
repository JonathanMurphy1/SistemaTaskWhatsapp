@model IEnumerable<SistemaTaskWhatsapp.Models.Proyecto>

@{
    ViewData["Title"] = "Lista de proyectos";
}

<div class="contenedor-principal">
    <div class="d-flex justify-content-between">
        <h3 class="col-3">@ViewData["Title"]</h3>
        <a asp-action="Create" class="btn btn-success col-2">Nuevo proyecto</a>
    </div>
    <div class="mt-4">
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Empresa</th>
                    <th>Estado</th>
                    <th>Descripción</th>
                    <th>Fecha de registro</th>
                    <th>Fecha de finalización</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">No hay proyectos registrados...</td>
                    </tr>
                }
                else
                {
                    foreach (var proyecto in Model)
                    {
                        <tr>
                            <td>@proyecto.Id</td>
                            <td>@proyecto.Nombre</td>
                            <td>@proyecto.Empresa.Nombre</td>
                            <td>@proyecto.Estado</td>
                            <td>@proyecto.Descripcion</td>
                            <td>@proyecto.FechaRegistro</td>
                            <td>@(proyecto.FechaFin == null ? "Vigente" : proyecto.FechaFin)</td>
                            <td>
                                <a class="btn btn-warning" asp-action="Edit" asp-route-id="@proyecto.Id">Editar</a>
                                <button class="btn btn-danger" data-id="@proyecto.Id" data-nombre="@proyecto.Nombre" data-bs-toggle="modal" data-bs-target="#modalEliminar">Borrar</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-danger">
                <h4 class="modal-title text-white">Eliminar</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <h5>Estas seguro de querer eliminar este proyecto? </h5>
                <p id="mostrarNombre"></p>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <form asp-action="Delete" method="post">
                        <input id="inputId" name="id" value="" type="hidden" />
                        <button type="submit" class="btn btn-danger">Borrar</button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/proyecto/proyectoIndex.js"></script>
}
