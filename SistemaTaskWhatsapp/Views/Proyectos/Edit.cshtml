@model SistemaTaskWhatsapp.Models.ViewModels.ProyectoVM

@{
    ViewData["Title"] = "Editar proyecto";
}

<style>
    /* Animación general de la vista */
    .fade-in-page {
        animation: fadeIn 0.6s ease forwards;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

</style>

<div class="contenedor-principal">
    <div class="text-center">
        <h3 class="col-3">@ViewData["Title"]</h3>
    </div>
    <div class="col-5 mt-4 border rounded shadow p-3 fade-in-page">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="Proyecto.Id" />
            <input type="hidden" asp-for="Proyecto.FechaRegistro" />
            <input type="hidden" asp-for="Proyecto.FechaFin" />
            <div class="form-group">
                <label for="nombre">Nombre:</label>
                <input type="text" id="nombre" asp-for="Proyecto.Nombre" class="form-control" placeholder="Escriba el nombre del proyecto..." />
                <span asp-validation-for="Proyecto.Nombre" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label for="descripcion">Descripción:</label>
                <textarea type="text" id="descripcion" asp-for="Proyecto.Descripcion" class="form-control" placeholder="Escriba una descripción acerca del proyecto..."></textarea>
                <span asp-validation-for="Proyecto.Descripcion" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label for="empresa">Empresa:</label>
                <select id="empresa" asp-for="Proyecto.EmpresaId" asp-items="@Model.ListaEmpresas" class="form-select">
                    <option disabled selected value="">--Elija una empresa--</option>
                </select>
                <span asp-validation-for="Proyecto.EmpresaId" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <label for="estado">Estado:</label>
                <select id="estado" asp-for="Proyecto.Estado" class="form-select">
                    <option disabled selected value="">--Elija un estado--</option>
                    <option value="0">Activo</option>
                    <option value="1">Inactivo</option>
                </select>
                <span asp-validation-for="Proyecto.Estado" class="text-danger"></span>
            </div>
            <br />
            <div class="d-flex justify-content-center gap-2 mt-3">
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
                <button type="submit" class="btn btn-success">Registrar</button>
            </div>
        </form>
    </div>
</div>
