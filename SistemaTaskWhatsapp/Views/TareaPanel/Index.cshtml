@model SistemaTaskWhatsapp.Models.ViewModels.TareaPanelVM
@using SistemaTaskWhatsapp.Utilidades

@{
    ViewData["Title"] = "Panel de tareas";
    int proyectoId = Model.ProyectoId;
}

<div class="text-center">
    <h1 class="display-4">Panel de tareas</h1>
    <div class="container border rounded shadow p-4">
        <h2>Tareas</h2>
        <br />
            @if (!Model.Lista.Any())
            {
                <h3 class="text-center text-muted">No hay tareas...</h3>
                <div class="d-flex justify-content-center gap-2">
                    <a class="btn btn-secondary" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver</a>
                    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalCrear"><i class="bi bi-plus"></i>Nueva tarea</button>
                </div>
            }
            else
            {
                <div class="d-flex justify-content-between">
                    <h4>Proyecto: @Model.Lista.First().Tarea.Proyecto.Nombre</h4>
                    <div class="d-flex justify-content-center gap-2">
                        <button class="btn btn-success" data-reporteId="@Model.Lista.FirstOrDefault().Tarea.ProyectoId" 
                            data-bs-toggle="modal" data-bs-target="#modalCrear"><i class="bi bi-plus"></i>Nueva tarea</button>
                        <a class="btn btn-secondary" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver</a>
                    </div>
                </div>
                <div class="contenedor-cartas row row-cols-1 row-cols-md-3 g-2 mt-3">
                    @foreach (var vm in Model.Lista)
                    {
                        string estadoColor;
                        switch(vm.Tarea.Estado)
                        {
                            case EstadosTarea.Pendiente:
                                estadoColor = "warning";
                                break;
                            case EstadosTarea.Finalizada:
                                estadoColor = "success";
                                break;
                            default:
                                estadoColor = "dark";
                                break;
                        }
                        
                        <div class="col">
                            <div class="card shadow">
                                <div class="card-header">
                                    <div class="d-flex justify-content-between">
                                        <h3 class="card-title">@vm.Tarea.Nombre</h3>
                                        <h3 class="card-title">Id: #@vm.Tarea.Id</h3>
                                    </div>
                                </div>
                                <div class="card-body text-start">
                                    <strong>Estado:</strong> <span class="badge bg-@estadoColor">@vm.Tarea.Estado</span>
                                    <br />
                                    <strong>Descripción:</strong>
                                    <p>@vm.Tarea.Descripcion</p>
                                    <p><strong>Fecha de Inicio:</strong> @vm.Tarea.FechaInicio.ToString("dd/MM/yyyy")</p>
                                    <p><strong>Fecha de entrega:</strong> @vm.Tarea.FechaEntrega?.ToString("dd/MM/yyyy")</p>
                                    <p><strong>Fecha de finalización:</strong> @(vm.Tarea.FechaTermino != null ? vm.Tarea.FechaTermino?.ToString("dd/MM/yyyy") : "Vigente")</p>
                                    <strong>Colaboradores:</strong> <span class="badge rounded-pill bg-warning">@(vm.Tarea.TareaEmpleados.Count() > 0 ? vm.Tarea.TareaEmpleados.Count() : "Sin asignar")</span>
                                    <br />
                                    <strong>Reportes por revisar:</strong> <span class="badge rounded-pill bg-warning">@vm.ReportesPendientesRevisar</span>
                                </div>
                                <div class="card-footer">
                                    <div class="d-flex justify-content-center gap-2">
                                        @if(vm.Tarea.Estado != EstadosTarea.Finalizada)
                                    {
                                        <button type="button" class="btn btn-success" data-tarea-id ="@vm.Tarea.Id" 
                                            data-nombre="@vm.Tarea.Nombre" data-bs-toggle="modal" data-bs-target="#modalFinalizar">Finalizar</button>
                                    }
                                    <a class="btn btn-primary" asp-controller="ReportePanel" asp-action="Index" asp-route-id="@vm.Tarea.Id"><i class="bi bi-file-earmark-text"></i> Reportes</a>
                                        <a class="btn btn-success" asp-controller="TareaEmpleados" asp-action="Index" asp-route-id="@vm.Tarea.Id"><i class="bi bi-people-fill"></i> Colaboradores</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        
    </div>
</div>

<!--Modal Detalle-->
<div class="modal fade" id="modalCrear">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h4 class="modal-title text-white">Nueva tarea</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formCrear" method="post" asp-action="Create">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="modal-body">
                    <input type="hidden" asp-for="Tarea.ProyectoId" value="@proyectoId" />
                    <div class="form-group">
                        <label for="nombre">Nombre:</label>
                        <input type="text" id="nombre" asp-for="Tarea.Nombre" class="form-control" placeholder="Escriba el nombre del proyecto..." />
                        <span asp-validation-for="Tarea.Nombre" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <label for="descripcion">Descripción:</label>
                        <textarea type="text" id="descripcion" asp-for="Tarea.Descripcion" class="form-control" placeholder="Escriba una descripción acerca del proyecto..."></textarea>
                        <span asp-validation-for="Tarea.Descripcion" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <label for="fechaentrega">Fecha de entrega:</label>
                        <input id="fechaEntrega" type="date" asp-for="Tarea.FechaEntrega" class="form-control" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Tarea.FechaEntrega" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="d-flex justify-content-center gap-2 mt-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                        <button type="submit" class="btn btn-success">Registrar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!--Modal Finalizar-->
<div class="modal fade" id="modalFinalizar">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h4 class="modal-title text-white">Finalizar tarea</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="formCrear" method="post" asp-action="Finalizar">
                <div class="modal-body">
                    <input type="hidden" name="ProyectoId" value="@Model.ProyectoId"/> 
                    <input type="hidden" class="input-tarea-id" name="TareaId" value="" />
                    <strong>¿Quieres finalizar esta tarea?</strong>
                    <p class="mostrar-nombre-tarea"><!--Aqui va el nombre y el id de la tarea--></p>
                </div>
                <div class="modal-footer">
                    <div class="d-flex justify-content-center gap-2 mt-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                        <button type="submit" class="btn btn-success">Finalizar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial"></partial>

    <script>
        const modal = document.getElementById('modalFinalizar');

        modal.addEventListener('show.bs.modal', (e) => {
            const boton = e.relatedTarget;
            const tareaId = boton.getAttribute('data-tarea-id');
            const nombre = boton.getAttribute('data-nombre');

            modal.querySelector('.input-tarea-id').value = tareaId;
            modal.querySelector('.mostrar-nombre-tarea').innerText = `${nombre} (Id: #${tareaId})`;
        });
    </script>

    @if(ViewBag.AbrirModalCrear)
    {
        <script>
            var modal = new bootstrap.Modal(document.getElementById('modalCrear'));
            modal.show();
        </script>
    }
}
