@model SistemaTaskWhatsapp.Models.ViewModels.LoginVM

@{
    ViewData["Title"] = "Login";
}

<div class="container border rounded shadow p-3 col-md-4 mx-auto mt-5 fade-in-page">
    <form asp-action="Login" method="post" class="">
        <h3 class="text-center">Iniciar sesión</h3>
        <input asp-for="Email" class="form-control mb-2" placeholder="Email"/>
        <input asp-for="Password" class="form-control mb-2" placeholder="Contraseña" />
        <button class="btn btn-primary w-100">Entrar</button>
        <div class="text-danger mt-2">
            @Html.ValidationSummary()
        </div>
    </form>
</div>