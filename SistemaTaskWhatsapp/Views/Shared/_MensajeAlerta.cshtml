@if (TempData["Mensaje"] != null)
{
    string tipoMensaje = TempData["TipoMensaje"].ToString();

    <div class="position-fixed top-0 end-0 mt-5 me-3 z-3 col-3 ms-auto alert alert-@tipoMensaje" alert-dismissible fade show" role="alert" id="alertaMensaje">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
    if (tipoMensaje != "danger")
    {
        <script>
                setTimeout(function () {
                var alerta = document.getElementById('alertaMensaje');
                if (alerta) {
                    // Cierra con animación de Bootstrap
                    var alertaBootstrap = bootstrap.Alert.getOrCreateInstance(alerta);
                    alertaBootstrap.close();
                }
            }, 4000); // ⏱️ 4000 ms = 4 segundos
        </script>
    }
}