@model IEnumerable<SistemaTaskWhatsapp.Models.Empresa>

@{
    ViewData["Title"] = "Lista de empresas";
}

<div class="contenedor-principal">
    <div class="d-flex justify-content-between align-items-center">
        <h3>@ViewData["Title"]</h3>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nueva empresa
        </a>
    </div>
    <div class="mt-4 table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Creada por:</th>
                    <th>Fecha de registro</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            <i class="bi bi-building"></i> 
                            No hay empresas registradas...
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var empresa in Model)
                    {
                        <tr>

                            <td>@empresa.Id</td>
                            <td><strong>@empresa.Nombre</strong></td>
                            <td>@empresa.ProgramaOrigen?.Nombre</td>
                            <td>@empresa.FechaRegistro.ToString("dd/MM/yyyy")</td>


                            <td class="text-center">


                                <a class="btn btn-sm btn-warning me-1"
                                   asp-action="Edit" asp-route-id="@empresa.Id"
                                   title="Editar"> <i class="bi bi-pencil-square"></i>
                                </a>
                                <button class="btn btn-sm btn-danger"
                                        title="Eliminar"
                                        data-id="@empresa.Id"
                                        data-nombre="@empresa.Nombre"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>


<div class="modal fade" id="modalRelaciones">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-info">
                <h5 class="modal-title text-white">Relaciones de la empresa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <h6 id="nombreEmpresaRelaciones"></h6>

                <ul id="listaRelaciones" class="list-group mt-3">
                    <!-- dinámico -->
                </ul>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-danger">
                <h4 class="modal-title text-white">Eliminar</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <h5>Estas seguro de querer eliminar esta empresa? </h5>
                <p id="mostrarNombre"></p>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <form asp-action="Delete" method="post">
                        <input id="inputId" name="id" type="hidden" />
                        <button type="submit" class="btn btn-danger">Borrar</button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>


<script>
    window.relacionesEmpresa = {
        @foreach (var empresa in Model)
        {
                <text>
                "@empresa.Id": [
                    @foreach (var rel in empresa.EmpresaProgramas)
                    {
                            <text>"@rel.Programa.Nombre",</text>
                    }
                ],
                </text>
        }
    };
</script>

@section Scripts {
    <script src="~/js/empresa/empresaIndex.js"></script>
}
