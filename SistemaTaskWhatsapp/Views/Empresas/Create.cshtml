@model SistemaTaskWhatsapp.Models.Empresa

@{
    ViewData["Title"] = "Registrar empresa";
}

<style>
    /* Animación general de la vista */
    .fade-in-page {
        animation: fadeIn 0.6s ease forwards;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

</style>

<div class="contenedor-principal">
    <div class="text-center">
        <h3 class="col-3">@ViewData["Title"]</h3>
    </div>
    <div class="col-5 mt-4 border rounded shadow p-3 fade-in-page">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label for="nombre">Nombre:</label>
                <input type="text" id="nombre" asp-for="Nombre" class="form-control" placeholder="Escriba el nombre de la empresa..."/>
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-center gap-2 mt-3">
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
                <button type="submit" class="btn btn-success">Registrar</button>
            </div>
        </form>
    </div>
</div>
