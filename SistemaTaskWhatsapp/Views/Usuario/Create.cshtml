@model SistemaTaskWhatsapp.Models.ViewModels.UsuarioCreateVM
@using SistemaTaskWhatsapp.Utilidades

@{
    ViewData["Title"] = "Agregar Usuario";
}

<h3 class="text-center">@ViewData["Title"]</h3>
<form method="post" asp-action="Create">
    <div class="row p-3 offset-1 border shadow">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="col-10 offset-1 p-4">
            <div class="d-flex gap-5">
                <div class="col-6">
                    <div class="form-group">
                        <label asp-for="Nombre">Nombre:</label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <label asp-for="Email">Email:</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <label asp-for="Password">Contraseña:</label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <label asp-for="Telefono">Telefono:</label>
                        <input asp-for="Telefono" class="form-control" maxlength="10" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label asp-for="Rol">Rol:</label>
                        <select id="selectRol" asp-for="Rol" class="form-control">
                            <option disabled selected value="">-- Seleccione un rol --</option>
                            <option value="0">Administrador</option>
                            <option value="1">Supervisor</option>
                            <option value="2">Empleado</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger"></span>
                    </div>

                    <!-- Formularios dinámicos -->
                    <div id="formularioDinamico" class="mt-3">
                        <div id="formSupervisor" style="display:none">
                            <partial name="Partials/_FormSupervisor" model="Model" />
                        </div>
                        <div id="formEmpleado" style="display:none">
                            <partial name="Partials/_FormEmpleado" model="Model" />
                        </div>
                    </div>
                </div>
            </div> 

            <div class="d-flex justify-content-center gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-return-left"></i> Volver
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-floppy2-fill"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        const selectRol = document.getElementById("selectRol");
        const formSupervisor = document.getElementById("formSupervisor");
        const formEmpleado = document.getElementById("formEmpleado");

        function toggleForms() {
            const rol = selectRol.value;

            // Supervisor
            const isSupervisor = rol === "1";
            formSupervisor.style.display = isSupervisor ? "block" : "none";
            formSupervisor.querySelectorAll("input, select")
                .forEach(el => el.disabled = !isSupervisor);

            // Empleado
            const isEmpleado = rol === "2";
            formEmpleado.style.display = isEmpleado ? "block" : "none";
            formEmpleado.querySelectorAll("input, select")
                .forEach(el => el.disabled = !isEmpleado);
        }

        selectRol.addEventListener("change", toggleForms);
        window.addEventListener("load", toggleForms);
    </script>
}