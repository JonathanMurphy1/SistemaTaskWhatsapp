@model SistemaTaskWhatsapp.Models.ViewModels.UsuarioCreateVM
@using SistemaTaskWhatsapp.Utilidades

@{
    ViewData["Title"] = "Agregar Usuario";
}

<br />
<h3 class="text-center">@ViewData["Title"]</h3>
<form method="post" asp-action="Create">
    <div class="row p-3 offset-1 border shadow">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="col-10 offset-1 p-4">
            <div class="d-flex gap-5">
                <div class="col-6">
                    <div class="form-group">
                        <label asp-for="Nombre">Nombre: </label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <label asp-for="Email">Email: </label>
                        <input asp-for="Email" class="form-control uppercase" placeholder="Ingrese el email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <label asp-for="Password">Contraseña: </label>
                        <input asp-for="Password" class="form-control" placeholder="Ingrese la contraseña" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <label asp-for="Telefono">Telefono: </label>
                        <input maxlength="10" asp-for="Telefono" class="form-control" placeholder="Ingrese el telefono" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                    <br />
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label asp-for="Rol">Rol:</label>
                        <select id="selectRol" asp-for="Rol" class="form-control">
                            <option disabled selected value="">-- Seleccione un rol --</option>
                            <option value="0">Administrador</option>
                            <option value="1">Supervisor</option>
                            <option value="2">Empleado</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
    </div> 
        <!--Aqui se mostrara el formulario dependiendo del rol seleccionado-->
        <div id="formularioDinamico" class="d-flex justify-content-center mt-5">
            <div id="formSupervisor" style="display:none">
                <partial name="Partials/_FormSupervisor" model="Model" />
            </div>
        </div>
    </div>
    <br />
    <br />
        <div class="d-flex justify-content-center gap-2">
             <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-return-left"></i> Volver
             </a>
             <button type="submit" class="btn btn-success">
                <i class="bi bi-floppy2-fill"></i> Guardar
             </button>
        </div>
     </div>
</form>

@section Scripts {
    <script>
        const select = document.getElementById("selectRol");

        function mostrarFormulario() {
            document.getElementById("formSupervisor").style.display = "none";
            
            if (select.value === "1") {
                document.getElementById("formSupervisor").style.display = "block";
            }
           
        }

        select.addEventListener("change", mostrarFormulario);
        window.addEventListener("load", mostrarFormulario);
    </script>
}


