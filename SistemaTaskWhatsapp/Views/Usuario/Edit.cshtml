@model SistemaTaskWhatsapp.Models.ViewModels.EditarUsuarioVM
@using SistemaTaskWhatsapp.Utilidades

@{
    ViewData["Title"] = "Editar Usuario";
}

<br />
<h3 class="text-center">@ViewData["Title"]</h3>

<form method="post" asp-action="Edit">
    <input asp-for="Id" type="hidden" />
    <div class="row px-2 offset-1 border shadow">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="col-10 offset-1 p-4">
            <div class="d-flex gap-5">
                <div class="col-6">
                    <div class="form-group">
                        <label asp-for="Nombre">Nombre: </label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="form-group">
                        <label asp-for="Email">Email: </label>
                        <input asp-for="Email" class="form-control uppercase" placeholder="Ingrese el email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <br /> 
                    <div class="form-group"> 
                        <label asp-for="Password">Contraseña: 
                        </label> <input type="password" asp-for="Password" value="" class="form-control" placeholder="Ingrese la nueva contraseña" />
                        <span asp-validation-for="Password" class="text-danger"></span> 
                    </div> 
                    <br />
                    <div class="form-group">
                        <label asp-for="Telefono">Telefono: </label>
                        <input asp-for="Telefono" maxlength="10" class="form-control" placeholder="Ingrese el telefono" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-6">
                    <div class="form-group">
                        <label asp-for="Rol"></label>
                        <select asp-for="Rol" class="form-control" id="selectRol">
                            <option value="0">Administrador</option>
                            <option value="1">Supervisor</option>
                            <option value="2">Empleado</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger"></span>
                    </div>

                    <!-- FORMULARIOS DINÁMICOS -->
                    <div id="formSupervisor" style="display:none">
                        <partial name="Partials/_FormSupervisorEdit" model="Model" />
                    </div>

                    <div id="formEmpleado" style="display:none">
                        <partial name="Partials/_FormEmpleadoEdit" model="Model" />
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-return-left"></i> Volver
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-floppy2-fill"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        const selectRol = document.getElementById("selectRol");
        const formSupervisor = document.getElementById("formSupervisor");
        const formEmpleado = document.getElementById("formEmpleado");

        function toggleForms() {
            const rol = selectRol.value;

            formSupervisor.style.display = rol === "1" ? "block" : "none";
            formEmpleado.style.display = rol === "2" ? "block" : "none";
        }

        selectRol.addEventListener("change", toggleForms);
        window.addEventListener("load", toggleForms);
    </script>
}
