@{
    ViewData["Title"] = "Lista de Usuarios";
}
<h1>@ViewData["Title"]</h1>


<div class="row">
    <div class="col-4 text-start">
        <p>Lista de usuarios</p>
    </div>
    <div class="col-4 text-end">
        <a asp-action="Create" class="btn btn-primary">
            Agregar <i class="fa-solid fa-plus"></i>
        </a>
    </div>
</div>

<div class="container mt-4">
    <!--Token para validacion de endpoints-->
    @Html.AntiForgeryToken()

    <div class="table-responsive">
        <table id="tblUsuario" class="table table-striped table-hover table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Telefono</th>
                    <th>Rol</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <!--Aqui se llena con DataTables-->
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/Usuario/UsuarioIndex.js"></script>
}

