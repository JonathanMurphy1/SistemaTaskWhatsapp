@model IEnumerable<SistemaTaskWhatsapp.Models.Usuario>

@{
    ViewData["Title"] = "Lista de Usuarios";
}

<div class="contenedor-principal">
    <div class="d-flex justify-content-between">
        <h3 class="col-3">@ViewData["Title"]</h3>
        <a asp-action="Create" class="btn btn-success col-2">Nuevo usuario</a>
    </div>
    <div class="mt-4">
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Telefono</th>
                    <th>Rol</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No hay usuarios registrados...</td>
                    </tr>
                }
                else
                {
                    foreach (var usuario in Model)
                    {
                        <tr>
                            <td>@usuario.Id</td>
                            <td>@usuario.Nombre</td>
                            <td>@usuario.Email</td>
                            <td>@usuario.Telefono</td>
                            <td>@usuario.Rol</td>
                            <td>
                                <a class="btn btn-warning" asp-action="Edit" asp-route-id="@usuario.Id">Editar</a>
                                <button class="btn btn-danger" data-id="@usuario.Id" data-nombre="@usuario.Nombre" data-bs-toggle="modal" data-bs-target="#modalEliminar">Borrar</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>



<!--Modal eliminar-->
<div class="modal fade" id="modalEliminar">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger">
                <h4 class="modal-title text-white">Eliminar</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h5>Estas seguro de querer borrar este usuario?</h5>
                <p id="mostrarId"></p>
                <p id="mostrarNombre"></p>
                <br />
                <div class="d-flex justify-content-around align-content-center gap-2">
                    <form method="post" asp-action="Delete">
                        <input id="idInput" type="hidden" name="id" value="" />
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fa-solid fa-xmark"></i> Cancelar
                        </button>
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash"></i> Eliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Usuario/UsuarioIndex.js"></script>
}

