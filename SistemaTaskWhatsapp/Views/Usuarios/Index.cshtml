@model IEnumerable<SistemaTaskWhatsapp.Models.Usuario>
@using SistemaTaskWhatsapp.Utilidades

@{
    ViewData["Title"] = "Lista de Usuarios";
}

<div class="contenedor-principal">
    <div class="d-flex justify-content-between align-items-center">
        <h3>@ViewData["Title"]</h3>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo usuario
        </a>
    </div>
    <div class="mt-4 table-responsive">
        <table class="table table-users table-hover">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Empresa</th>
                    <th>Registrado en</th>
                    <th>Rol</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any()) 
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="bi bi-people"></i> 
                            No hay usuarios registrados...
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var usuario in Model)
                    {
                        <tr>
                            <td><strong>@usuario.Nombre</strong></td>
                            <td>@usuario.Email</td>
                            <td>@(usuario.PhoneNumber ?? "Sin número")</td>
                            <td>@(usuario.EmpresaId != null ? usuario.Empresa.Nombre : "Sin asignar")</td>
                            <td>@(usuario.ProgramaId != null ? usuario.Programa.Nombre : "Sin asignar")</td>
                            <td>
                                @if (usuario.Rol == Roles.Administrador)
                                {
                                    <span class="badge bg-danger text-light">Administrador</span>
                                }
                                else if (usuario.Rol == Roles.Supervisor)
                                                {
                                    <span class="badge bg-warning text-light">Supervisor</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-light">Empleado</span>
                                }
                            </td>
                            <td class="text-center">
                                <a class="btn btn-sm btn-warning me-1"
                                   asp-action="Edit" asp-route-id="@usuario.Id">
                                   <i class="bi bi-pencil-square"></i>
                                </a>
                                <button class="btn btn-sm btn-danger"
                                    data-id="@usuario.Id" data-nombre="@usuario.Nombre"
                                    data-bs-toggle="modal" data-bs-target="#modalEliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header bg-danger">
                <h4 class="modal-title text-white">Eliminar</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <h5>Estas seguro de querer borrar este usuario?</h5>
                <p id="mostrarNombre"></p>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <div class="d-flex justify-content-center gap-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>

                    <form asp-action="Delete" method="post">
                        <input id="inputId" name="id" type="hidden" />
                        <button type="submit" class="btn btn-danger">Borrar</button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Usuario/UsuarioIndex.js"></script>
}
