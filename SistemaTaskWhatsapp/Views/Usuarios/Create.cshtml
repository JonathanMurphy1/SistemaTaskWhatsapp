@model SistemaTaskWhatsapp.Models.ViewModels.UsuarioCreateVM
@using SistemaTaskWhatsapp.Utilidades

@{
    ViewData["Title"] = "Agregar Usuario";
}

<style>
    /* Animación general de la vista */
    .fade-in-page {
        animation: fadeIn 0.6s ease forwards;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(15px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Animación de formularios dinámicos */
    .animated-form {
        overflow: hidden;
        transition: max-height 0.4s ease, opacity 0.3s ease, transform 0.3s ease;
        max-height: 0;
        opacity: 0;
        transform: translateY(-10px);
    }

        .animated-form.show {
            max-height: 500px;
            opacity: 1;
            transform: translateY(0);
        }
</style>

<h3 class="text-center">@ViewData["Title"]</h3>

<form method="post" asp-action="Create">
    <div class="row p-3 offset-1 border shadow fade-in-page">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="col-10 offset-1 p-4">
            <div class="d-flex gap-5">
                <div class="col-6">
                    <div class="form-group">
                        <label asp-for="Nombre">Nombre:</label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <br />

                    <div class="form-group">
                        <label asp-for="Email">Email:</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <br />

                    <div class="form-group">
                        <label asp-for="Password">Contraseña:</label>
                        <input type="password" asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <br />

                    <div class="form-group">
                        <label asp-for="Telefono">Teléfono:</label>
                        <input asp-for="Telefono" class="form-control" maxlength="10" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-6">

                    <div class="form-group">
                        <label>Programa origen:</label>
                        <select id="programa" asp-for="ProgramaId" asp-items="@Model.ListaProgramas" class="form-select">
                            <option value="">-- Seleccione un programa --</option>
                        </select>
                        <span asp-validation-for="ProgramaId" class="text-danger"></span>
                    </div>
                    <br />

                    <div class="form-group">
                        <label for="empresa">Empresa:</label>
                        <select id="empresa" asp-for="EmpresaId" class="form-select">
                            <option disabled selected value="">--Elija una empresa--</option>
                        </select>
                    </div>
                    <br />

                    <div class="form-group">
                        <label asp-for="Rol">Rol:</label>
                        <select id="selectRol" asp-for="Rol" class="form-control">
                            <option disabled selected value="">-- Seleccione un rol --</option>
                            <option value="0">Administrador</option>
                            <option value="1">Supervisor</option>
                            <option value="2">Empleado</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger"></span>
                    </div>

                    <!-- Formularios dinámicos -->
                    <div id="formularioDinamico" class="mt-3">

                        <div id="formSupervisor" class="animated-form">
                            <partial name="Partials/_FormSupervisor" model="Model" />
                        </div>

                        <div id="formEmpleado" class="animated-form">
                            <partial name="Partials/_FormEmpleado" model="Model" />
                        </div>

                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-return-left"></i> Volver
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-floppy2-fill"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        const selectRol = document.getElementById("selectRol");
        const formSupervisor = document.getElementById("formSupervisor");
        const formEmpleado = document.getElementById("formEmpleado");

        function toggleForms() {
            const rol = selectRol.value;

            // Supervisor
            const isSupervisor = rol === "1";
            formSupervisor.classList.toggle("show", isSupervisor);
            formSupervisor.querySelectorAll("input, select")
                .forEach(el => el.disabled = !isSupervisor);

            // Empleado
            const isEmpleado = rol === "2";
            formEmpleado.classList.toggle("show", isEmpleado);
            formEmpleado.querySelectorAll("input, select")
                .forEach(el => el.disabled = !isEmpleado);
        }

        selectRol.addEventListener("change", toggleForms);
        window.addEventListener("load", toggleForms);
    </script>

    <script>
        const programaSelect = document.getElementById("programa");
        const empresaSelect = document.getElementById("empresa");

        programaSelect.addEventListener("change", async function () {
            const programaId = this.value;

            empresaSelect.innerHTML = '<option value="">Cargando...</option>';

            if (!programaId) {
                empresaSelect.innerHTML = '<option value="">-- Seleccione una empresa --</option>';
                return;
            }

            const response = await fetch(`/Usuarios/GetEmpresasPorPrograma?programaId=${programaId}`);
            const data = await response.json();

            empresaSelect.innerHTML = '<option value="">-- Seleccione una empresa --</option>';

            data.forEach(e => {
                empresaSelect.innerHTML += `<option value="${e.id}">${e.nombre}</option>`;
            });
        });
    </script>
}
